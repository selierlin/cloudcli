{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `react-syntax-highlighter` is listed because `src/shared/syntaxTheme.ts`
    // imports its Prism styles, and that package's types are a set of
    // `declare module` blocks — which only reach the program if the package is
    // named here, since `types` turns off the automatic `@types` sweep.
    "types": ["vite/client", "node", "@playwright/test", "react-syntax-highlighter"]
  },
  "include": [
    "../../playwright.theme-tokens.config.ts",
    "../../src/vite-env.d.ts",
    "./main.ts",
    "./token-contract.spec.ts",
    "./terminal-tokens.spec.ts",
    "./graph-lanes.spec.ts",
    "./mobile-terminal-selection.spec.ts",
    "./theme-chrome.spec.ts",
    "./theme-overlays.spec.ts",
    "./user-theme-paste.spec.ts",
    "./user-theme-tmtheme.spec.ts",
    "./vite.config.ts"
  ]
}
